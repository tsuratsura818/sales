# =============================================================
# 小晴日和 Phase 2 環境変数テンプレート
# Phase 1 の .env.local に不足分を追記する形で使う
# 値は絶対にコミットしない
# =============================================================

# Supabase（https://supabase.com/dashboard → Project Settings → API で取得）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 使用スキーマ（固定。public に作らない）
NEXT_PUBLIC_SUPABASE_SCHEMA=koharubiyori

# サイトURL（QR・OGP・構造化データの絶対URL生成に使う）
# 掛け紙は印刷物なのでURL変更は不可。確定してから刷ること
NEXT_PUBLIC_SITE_URL=

# 作家画像の保存バケット（未確定。Phase 1 のバケットを流用するか要確認）
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=

# 管理画面の許可メールアドレス（カンマ区切り／Supabase Auth のロール判定に移行するまでの暫定）
ADMIN_ALLOWED_EMAILS=
